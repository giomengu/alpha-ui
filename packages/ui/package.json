{
  "name": "@alpha/ui",
  "version": "0.1.0",
  "description": "Shared UI components and theme system",
  "main": "src/index.js",
  "module": "src/index.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.js --format esm,cjs --sourcemap --clean --external react,react-dom,styled-components",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=5",
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "three": ">=0.150.0"
  },
  "dependencies": {
    "polished": "^4.3.1",
    "react-icons": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.16.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8",
    "three": "^0.158.0",
    "tsup": "^8.0.2",
    "vitest": "^1.3.1"
  }
}
